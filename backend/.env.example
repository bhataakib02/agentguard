# AGENTGUARD Backend Environment Variables

# Environment: production or development
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase PostgreSQL Connection String (Replace [YOUR-PASSWORD] with your Supabase DB password)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://agentguard.vercel.app

# Email Delivery Configuration (NONE, RESEND, SMTP, MOCK)
EMAIL_PROVIDER=RESEND
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=AgentGuard <onboarding@resend.dev>

# SMTP Configuration (Fallback if EMAIL_PROVIDER=SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@agentguard.com
